# Deploy/upgrade configuration template.
#
# Copy this to an environment-specific file (e.g. mainnet.env or sepolia.env, both
# gitignored/untracked) and `source` it before running forge scripts:
#
#   source mainnet.env
#   forge script script/Deploy.s.sol --broadcast --account <keystore>
#
# Every variable below is read via vm.envUint / vm.envAddress in script/Deploy.s.sol —
# a missing one makes the deploy revert. WIDTH/HEIGHT are NOT here; they come from
# map/land_mask.json.

# Accepted stablecoins, all treated 1:1 when buying pixels. Comma-separated, NO spaces.
# Each must be a real ERC-20 — initialize() reads decimals() on-chain and reverts otherwise.
# (Celo mainnet example: USDT, USDC, cUSD.)
export ACCEPTED_TOKENS=0xUSDT...,0xUSDC...,0xcUSD...

export INITIAL_PRICE=10000   # starting pixel price in 6-decimal base units (10000 = $0.01)
export MIN_PRICE=1           # price floor in base units (1 = $0.000001)
export HALVING_TIME_DAYS=182 # epoch length; price gradually halves over this window
export INITIAL_FEE_RATE=500  # treasury fee on resales, basis points (500 = 5%)

# RPC endpoint. forge uses ETH_RPC_URL by default when --rpc-url is omitted.
export ETH_RPC_URL=https://forno.celo.org

# Display token for the frontend ABI export (script/export-abi.py). Usually one of
# ACCEPTED_TOKENS. Not used by the Solidity deploy.
export USDT_ADDRESS=0xUSDT...

# Set after the first deploy; used by export-abi.py and as a reference for upgrades.
export PROXY_ADDRESS=
