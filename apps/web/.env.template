# Default environment variables for generated Celo projects
#
# NOTE: every NEXT_PUBLIC_* value is inlined into the client bundle at
# BUILD time. Setting or changing one in Vercel does nothing until the
# next deploy.

# Map rollout controls
# --------------------
# Which maps are revealed (visible/playable), as a comma-separated list of
# map ids. Optional — when unset, only WORLD (id 0) is revealed and continents
# stay hidden until opened. To open continents, list their ids (see the
# Deployments table in README for id↔continent). Example: reveal World +
# Africa + Asia => 0,1,2. Takes effect on the next deploy (NEXT_PUBLIC_ is
# inlined at build time).
NEXT_PUBLIC_REVEALED_MAP_IDS=
#
# Average-pixel-price threshold (USD) at which the "active map" pointer
# advances new wallets to the next revealed map. Optional — defaults to $2.
NEXT_PUBLIC_MAP_THRESHOLD_USD=
#
# Per-map address override, for pointing a map at a different deployment
# WITHOUT editing the registry in src/lib/maps/contracts.ts. Comma-separated
# `id:address` pairs. Intended for PREVIEW deploys only (leave UNSET in
# Production). Dimensions/slug/mask still come from the static registry entry,
# so override a map whose grid matches the target deployment. Example — QA the
# audited Africa contract (127×134) on a preview deploy by overriding id 1 and
# revealing it via NEXT_PUBLIC_REVEALED_MAP_IDS=0,1:
#   NEXT_PUBLIC_MAP_ADDRESS_OVERRIDES=1:0x2E7F1c57db241D529f7BD6B1fA8229984267Af23
NEXT_PUBLIC_MAP_ADDRESS_OVERRIDES=

# Buy-flow guards (audited buyPixels slippage + deadline)
# -------------------------------------------------------
# Slippage tolerance for buys, in basis points. The buy quotes a maxTotalCost
# this far above the live selectionPrice; the contract reverts if the
# execution-time total exceeds it. Same buffer drives the token approval.
# Optional — defaults to 200 (2%).
NEXT_PUBLIC_BUY_SLIPPAGE_BPS=
#
# Deadline window for buys, in seconds. The contract rejects a buy that hasn't
# mined within this window (protects against execution at a stale price).
# Optional — defaults to 1200 (20 minutes).
NEXT_PUBLIC_BUY_DEADLINE_SECONDS=

# ERC-8021 builder-code attribution (@celo/attribution-tags). The code emitted
# on-chain with every tx (buyPixels, approve, updateProfile) so Celo can
# attribute activity back to Mondeto. Optional — defaults to Mondeto's assigned
# code (celo_jz4httik) when unset, so production keeps working without it.
NEXT_PUBLIC_ATTRIBUTION_CODE=


# Authenticated Celo mainnet RPC (Forno). Optional — when unset, the app
# falls back to the public Forno endpoint. NEXT_PUBLIC_ is required: the
# URL is read by wagmi/viem transports that run in the browser, so the
# value is inlined into the client bundle and visible in devtools.
# Protect the key with a domain allowlist on the provider dashboard, not
# by hiding this env var.
NEXT_PUBLIC_FORNO_RPC_URL=


# WalletConnect / Reown project id — used by Privy's wallet_connect
# option (desktop QR flow). Create at https://cloud.reown.com and
# allowlist mondeto.app + www.mondeto.app. MiniPay users never touch
# this path.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here


# Privy app id (desktop wallet connect UI). Public identifier; falls
# back to the current production app id when unset.
NEXT_PUBLIC_PRIVY_APP_ID=


# PostHog — product analytics + error tracking (US cloud, company org).
# Get the project key from https://us.posthog.com → Project Settings →
# Project API Key. Requests are reverse-proxied through `/ingest` (see
# next.config.js) so adblockers don't drop them — the host
# (us.i.posthog.com) is hardcoded there; the key MUST belong to a
# US-region project or events are silently rejected.
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key_here


# PostHog OTel logs — server-side log ingestion via OpenTelemetry.
# `apps/web/instrumentation.ts` wires a BatchLogRecordProcessor with an
# OTLP HTTP exporter pointing at PostHog's logs endpoint, and
# `apps/web/src/lib/logger.ts` exposes the logger to app code.
#
# Reuses NEXT_PUBLIC_POSTHOG_KEY (PostHog project keys are public by design —
# they already ship in the client bundle). Endpoint override is optional;
# defaults to the US cloud.
# POSTHOG_OTEL_LOGS_ENDPOINT=https://us.i.posthog.com/i/v0/otel/v1/logs


# Support intake — Google Form URL opened by the in-app SUPPORT button.
# Falls back to the legacy Telegram group while unset.
NEXT_PUBLIC_SUPPORT_FORM_URL=


# Goldsky subgraph — the public GraphQL query endpoint of the Mondeto subgraph
# (apps/subgraph). Powers earn/spend (/api/pnl), the AREA leaderboard (with the
# "reached the count first" tie-break) and analytics (/api/analytics). Read-only
# and public — NO API key goes here (the Goldsky deploy key lives in ~/.goldsky).
# When UNSET, those routes fall back to the legacy live log-scan, so behaviour is
# unchanged until this is set. Get the URL from `goldsky subgraph deploy` output;
# it looks like:
#   https://api.goldsky.com/api/public/project_<ID>/subgraphs/mondeto/1.0.2/gn
# NEXT_PUBLIC_ is inlined at build time, so a Vercel change needs a redeploy.
NEXT_PUBLIC_GOLDSKY_SUBGRAPH_URL=


# Environment registry switch: 'staging' points reads at Celo Sepolia
# map contracts; anything else (or unset) = production / Celo mainnet.
# NEXT_PUBLIC_ENV=staging


# Active-map auto-advance threshold in USD (see the operator runbook in
# the team Drive, "Mondeto Docs"). Non-numeric values fall back to the
# $2.00 default.
# NEXT_PUBLIC_MAP_THRESHOLD_USD=2
